<% content_for :title, t("observation_impressions.samples.page_title") %>

<section class="impression-samples-page">
  <header class="impression-samples-header">
    <div>
      <p class="eyebrow"><%= t("observation_impressions.samples.eyebrow") %></p>
      <h1 class="display"><%= t("observation_impressions.samples.title") %></h1>
      <p class="lead"><%= t("observation_impressions.samples.description") %></p>
    </div>
    <nav class="impression-samples-locale" aria-label="Language">
      <%= link_to "简体中文", frontend_preview_impression_samples_path(locale: "zh-CN"), aria: { current: I18n.locale == :"zh-CN" ? "page" : nil } %>
      <%= link_to "日本語", frontend_preview_impression_samples_path(locale: "ja"), aria: { current: I18n.locale == :ja ? "page" : nil } %>
    </nav>
  </header>

  <p class="impression-samples-notice"><%= t("observation_impressions.samples.notice") %></p>

  <main class="impression-samples-grid">
    <% @impression_samples.each_with_index do |sample, sample_index| %>
      <% impression = sample.fetch(:impression) %>
      <% outline_label = ObservationOptions.label(:outlines, impression.outline_key) %>
      <article class="impression-sample" data-sample-outline="<%= impression.outline_key %>">
        <header class="impression-sample__header">
          <div>
            <span><%= format("%02d", sample_index + 1) %></span>
            <h2><%= outline_label %></h2>
          </div>
          <code><%= impression.outline_key %></code>
        </header>

        <div class="impression-sample__visual">
          <%= render "observation_impressions/visual",
            impression:,
            id_prefix: "sample-#{impression.outline_key}-hero",
            label: t("observation_impressions.samples.visual_label", outline: outline_label) %>
        </div>

        <div class="impression-sample__parts" aria-label="<%= t("observation_impressions.samples.part_legend") %>">
          <% ObservationOptions.part_keys.each do |part_key| %>
            <% part = impression.part(part_key) %>
            <span>
              <i style="--part-color: <%= ObservationVisualCatalog.color_hex(part.primary_color_key) %>"></i>
              <%= ObservationOptions.label(:parts, part_key) %>
            </span>
          <% end %>
        </div>

        <section class="impression-sample__summaries" aria-label="<%= t("observation_impressions.samples.summaries") %>">
          <% sample.fetch(:summaries).each do |locale, summary| %>
            <div class="observation-summary" lang="<%= locale %>">
              <h3><%= locale == :ja ? "日本語" : "简体中文" %></h3>
              <%= render "observation_impressions/summary", summary: %>
            </div>
          <% end %>
        </section>

        <aside class="impression-sample__thumbnail">
          <span><%= t("observation_impressions.samples.thumbnail") %></span>
          <div>
            <%= render "observation_impressions/visual",
              impression:,
              id_prefix: "sample-#{impression.outline_key}-thumb",
              label: t("observation_impressions.samples.thumbnail_label", outline: outline_label) %>
          </div>
        </aside>
      </article>
    <% end %>
  </main>
</section>
