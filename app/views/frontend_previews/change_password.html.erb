<% content_for :title, t("frontend_previews.change_password.page_title") %>

<section class="app-page auth-view">
  <%= render "shared/auth_header", title: t("frontend_previews.change_password.header_title"), back_path: frontend_preview_settings_path(locale: I18n.locale), back_label: t("frontend_previews.change_password.back"), header_action: t("frontend_previews.change_password.header_action") %>

  <main class="app-content auth-content">
    <%= render "shared/auth_intro", show_brand: false, eyebrow: t("frontend_previews.change_password.eyebrow"), title: t("frontend_previews.change_password.title"), description: t("frontend_previews.change_password.description") %>

    <form class="auth-card form-stack" data-static-preview="true">
      <label class="form-label">
        <span><%= t("frontend_previews.forms.current_password") %></span>
        <input class="input-field" type="password" autocomplete="current-password" placeholder="<%= t("frontend_previews.forms.current_password_placeholder") %>" required>
      </label>
      <label class="form-label">
        <span><%= t("frontend_previews.forms.new_password") %></span>
        <input class="input-field" type="password" autocomplete="new-password" placeholder="<%= t("frontend_previews.forms.new_password_placeholder") %>" required>
      </label>
      <label class="form-label">
        <span><%= t("frontend_previews.forms.new_password_confirmation") %></span>
        <input class="input-field" type="password" autocomplete="new-password" placeholder="<%= t("frontend_previews.forms.new_password_confirmation_placeholder") %>" required>
      </label>
      <%= link_to t("frontend_previews.change_password.submit"), frontend_preview_settings_path(locale: I18n.locale), class: "primary-button full" %>
    </form>

    <aside class="notice change-password-notice">
      <%= t("frontend_previews.change_password.preview_note") %>
    </aside>
  </main>
</section>
