<% content_for :title, t("observations.show.page_title") %>

<section class="app-page detail-page">
  <header class="app-header">
    <%= link_to t("observations.common.back"), observations_path, class: "back-button" %>
    <%= link_to t("observations.show.edit"), edit_observation_path(@observation), class: "header-action detail-edit-link" %>
  </header>

  <main class="app-content detail-content">
    <section class="detail-hero">
      <div class="detail-meta">
        <span class="status-pill"><%= t("observations.status.pending") %></span>
        <span class="subtle"><%= l(@observation.created_at, format: :short) %></span>
      </div>
      <%= render "observation_impressions/visual",
        impression: @impression,
        id_prefix: "observation-#{@observation.id}-detail",
        label: t("observation_impressions.preview.saved_visual_label") %>
      <span class="detail-concept-label"><%= t("observations.show.outline_note") %></span>
    </section>

    <section class="detail-section">
      <p class="eyebrow"><%= t("observations.show.eyebrow") %></p>
      <h1 class="display detail-title"><%= t("observations.show.title") %></h1>
      <p class="lead detail-lead"><%= t("observations.show.description") %></p>
    </section>

    <section class="section-block" aria-labelledby="recorded-parts-title">
      <div class="section-head"><h2 class="section-title" id="recorded-parts-title"><%= t("observations.show.parts_heading") %></h2></div>
      <%= render "observation_impressions/summary", summary: @summary %>
    </section>

    <section class="section-block" aria-labelledby="supplement-title">
      <div class="section-head"><h2 class="section-title" id="supplement-title"><%= t("observations.show.supplement_heading") %></h2></div>
      <dl class="detail-facts">
        <div>
          <dt><%= t("observations.show.locations") %></dt>
          <dd><%= @activity_locations.any? ? @activity_locations.map { |selection| observation_option_label(:activity_locations, selection.location_key) }.join(" · ") : t("observations.show.not_recorded") %></dd>
        </div>
        <div>
          <dt><%= t("observations.show.behavior") %></dt>
          <dd><%= @observation.behavior_text.presence || t("observations.show.not_recorded") %></dd>
        </div>
      </dl>
    </section>
  </main>

  <%= render "shared/bottom_navigation", items: [
    { label: t("frontend_previews.navigation.history"), icon: "⌂", path: observations_path, active: true },
    { label: t("frontend_previews.navigation.new_observation"), icon: "＋", path: new_observation_path, active: false },
    { label: t("frontend_previews.navigation.settings"), icon: "⚙", path: settings_path, active: false }
  ] %>
</section>
