<nav class="bottom-nav" aria-label="<%= t("frontend_previews.shared.bottom_navigation") %>">
  <% items.each do |item| %>
    <% if item[:path].present? %>
      <%= link_to item[:path], class: ["bottom-nav__item", ("is-active" if item[:active])].compact.join(" ") do %>
        <b aria-hidden="true"><%= item[:icon] %></b>
        <span><%= item[:label] %></span>
      <% end %>
    <% else %>
      <button class="bottom-nav__item" type="button" aria-disabled="true">
        <b aria-hidden="true"><%= item[:icon] %></b>
        <span><%= item[:label] %></span>
      </button>
    <% end %>
  <% end %>
</nav>
