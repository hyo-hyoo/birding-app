<% content_for :title, t("frontend_previews.reset_password.page_title") %>

<section class="app-page auth-view">
  <%= render "shared/auth_header", title: t("frontend_previews.reset_password.header_title"), header_action: t("frontend_previews.reset_password.header_action") %>

  <main class="app-content auth-content">
    <%= render "shared/auth_intro", show_brand: false, eyebrow: t("frontend_previews.reset_password.eyebrow"), title: t("frontend_previews.reset_password.title"), description: t("frontend_previews.reset_password.description") %>

    <form class="auth-card form-stack" data-static-preview="true">
      <label class="form-label">
        <span><%= t("frontend_previews.forms.new_password") %></span>
        <input class="input-field" type="password" autocomplete="new-password" placeholder="<%= t("frontend_previews.forms.new_password_placeholder") %>" required>
      </label>
      <label class="form-label">
        <span><%= t("frontend_previews.forms.new_password_confirmation") %></span>
        <input class="input-field" type="password" autocomplete="new-password" placeholder="<%= t("frontend_previews.forms.new_password_confirmation_placeholder") %>" required>
      </label>
      <button class="primary-button full" type="button"><%= t("frontend_previews.reset_password.submit") %></button>
    </form>

    <aside class="preview-note">
      <p><%= t("frontend_previews.reset_password.preview_note") %></p>
      <%= link_to t("frontend_previews.reset_password.preview_link"), frontend_preview_reset_success_path(locale: I18n.locale), class: "preview-link" %>
    </aside>
  </main>
</section>
