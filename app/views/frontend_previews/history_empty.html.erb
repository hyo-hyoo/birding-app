<% content_for :title, t("frontend_previews.history_empty.page_title") %>

<section class="app-page preview-history-page">
  <header class="app-header">
    <div>
      <p class="eyebrow eyebrow--compact"><%= t("frontend_previews.history_empty.eyebrow") %></p>
      <h1 class="screen-title"><%= t("frontend_previews.history_empty.header_title") %></h1>
    </div>
  </header>

  <main class="app-content preview-history-content">
    <%= render "shared/result_card", icon: "⌁", eyebrow: t("frontend_previews.history_empty.result_eyebrow"), title_tag: :h2, title: t("frontend_previews.history_empty.title"), description: t("frontend_previews.history_empty.description") do %>
      <button class="primary-button full" type="button"><%= t("frontend_previews.history_empty.new_observation") %></button>
    <% end %>

    <aside class="preview-note">
      <p><%= t("frontend_previews.history_empty.preview_note") %></p>
      <%= link_to t("frontend_previews.history_empty.preview_link"), frontend_preview_login_path(locale: I18n.locale), class: "preview-link" %>
    </aside>
  </main>

  <%= render "shared/bottom_navigation", items: [
    { icon: "⌂", label: t("frontend_previews.navigation.history"), active: true, path: frontend_preview_history_empty_path(locale: I18n.locale) },
    { icon: "＋", label: t("frontend_previews.navigation.new_observation") },
    { icon: "⚙", label: t("frontend_previews.navigation.settings") }
  ] %>
</section>
