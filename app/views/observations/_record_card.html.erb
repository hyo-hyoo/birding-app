<% impression = ObservationImpression.from_observation(observation) %>

<%= link_to observation_path(observation), class: "record-card-link", aria: { label: t("observations.index.open_record") } do %>
  <article class="record-card record-card--pending">
    <div class="bird-thumb">
      <%= render "observation_impressions/visual",
        impression:,
        id_prefix: "observation-#{observation.id}-thumb",
        label: t("observation_impressions.preview.thumbnail_label") %>
    </div>
    <div class="record-card__content">
      <span class="status-pill"><%= t("observations.status.pending") %></span>
      <h3><%= l(observation.created_at, format: :short) %></h3>
      <small class="record-card__meta"><%= t("observations.index.parts_count", count: observation.part_impressions.size) %></small>
    </div>
    <span class="chevron" aria-hidden="true">›</span>
  </article>
<% end %>
